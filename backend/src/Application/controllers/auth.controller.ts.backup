import { Request, Response } from 'express';
import { authService } from '../../Domain/services/auth.service';

export const register = async (req: Request, res: Response) => res.status(201).json({ data: await authService.register(req.body) });
export const login = async (req: Request, res: Response) => res.json({ data: await authService.login(req.body.email, req.body.password) });
export const me = async (req: Request, res: Response) => res.json({ data: await authService.me(req.userId!) });
