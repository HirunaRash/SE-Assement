import { prisma } from '../../prisma';

const userInclude = { user_roles_user_roles_userIdTousers: { include: { roles: true } } } as const;

export const userRepository = {
  findById: (id: number) => prisma.users.findUnique({ where: { id }, include: userInclude }),
  findByEmail: (email: string) => prisma.users.findUnique({ where: { email }, include: userInclude }),
  list: (where: any, skip: number, take: number) => prisma.users.findMany({ where, skip, take, orderBy: { createdAt: 'desc' }, include: userInclude }),
  count: (where: any) => prisma.users.count({ where }),
  create: (data: any) => prisma.users.create({ data, include: userInclude }),
  update: (id: number, data: any) => prisma.users.update({ where: { id }, data, include: userInclude }),
  delete: (id: number) => prisma.users.delete({ where: { id } }),
  role: (name: string) => prisma.roles.findUnique({ where: { name } }),
  assignRole: (data: any) => prisma.user_roles.create({ data }),
  removeRoles: (userId: number) => prisma.user_roles.deleteMany({ where: { userId } }),
};
