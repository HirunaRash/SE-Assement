generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model project_team_members {
  id         Int       @id @default(autoincrement())
  projectId  Int
  userId     Int
  assignedAt DateTime? @default(now()) @db.Timestamp(0)
  projects   projects  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_team_members_ibfk_1")
  users      users     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "project_team_members_ibfk_2")

  @@unique([projectId, userId], map: "unique_project_member")
  @@index([projectId], map: "idx_projectId")
  @@index([userId], map: "idx_userId")
}

model projects {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(255)
  description          String?                @db.Text
  color                String?                @db.VarChar(7)
  status               projects_status?       @default(active)
  createdBy            Int?
  createdAt            DateTime?              @default(now()) @db.Timestamp(0)
  updatedAt            DateTime?              @default(now()) @db.Timestamp(0)
  project_team_members project_team_members[]
  users                users?                 @relation(fields: [createdBy], references: [id], onUpdate: NoAction, map: "projects_ibfk_1")
  reports              reports[]

  @@index([createdBy], map: "createdBy")
  @@index([name], map: "idx_name")
  @@index([status], map: "idx_status")
}

model report_achievements {
  id               Int                         @id @default(autoincrement())
  reportId         Int
  description      String                      @db.Text
  impact           report_achievements_impact? @default(medium)
  isKeyAchievement Boolean?                    @default(false)
  createdAt        DateTime?                   @default(now()) @db.Timestamp(0)
  updatedAt        DateTime?                   @default(now()) @db.Timestamp(0)
  reports          reports                     @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_achievements_ibfk_1")

  @@index([isKeyAchievement], map: "idx_isKeyAchievement")
  @@index([reportId], map: "idx_reportId")
}

model report_blockers {
  id          Int                     @id @default(autoincrement())
  reportId    Int
  description String                  @db.Text
  impact      report_blockers_impact? @default(medium)
  isKeyIssue  Boolean?                @default(false)
  resolution  String?                 @db.Text
  createdAt   DateTime?               @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?               @default(now()) @db.Timestamp(0)
  reports     reports                 @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_blockers_ibfk_1")

  @@index([isKeyIssue], map: "idx_isKeyIssue")
  @@index([reportId], map: "idx_reportId")
}

model report_next_week_tasks {
  id             Int                              @id @default(autoincrement())
  reportId       Int
  taskName       String                           @db.VarChar(500)
  priority       report_next_week_tasks_priority? @default(medium)
  estimatedHours Decimal?                         @db.Decimal(10, 2)
  createdAt      DateTime?                        @default(now()) @db.Timestamp(0)
  updatedAt      DateTime?                        @default(now()) @db.Timestamp(0)
  reports        reports                          @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_next_week_tasks_ibfk_1")

  @@index([reportId], map: "idx_reportId")
}

model report_optional_fields {
  id              Int       @id @default(autoincrement())
  reportId        Int
  notes           String?   @db.Text
  additionalLinks String?   @db.VarChar(500)
  createdAt       DateTime? @default(now()) @db.Timestamp(0)
  updatedAt       DateTime? @default(now()) @db.Timestamp(0)
  reports         reports   @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_optional_fields_ibfk_1")

  @@index([reportId], map: "idx_reportId")
}

model report_review_history {
  id             Int                                   @id @default(autoincrement())
  reportId       Int
  reviewedBy     Int?
  previousStatus report_review_history_previousStatus?
  newStatus      report_review_history_newStatus
  comment        String?                               @db.Text
  createdAt      DateTime?                             @default(now()) @db.Timestamp(0)
  reports        reports                               @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_review_history_ibfk_1")
  users          users?                                @relation(fields: [reviewedBy], references: [id], onUpdate: NoAction, map: "report_review_history_ibfk_2")

  @@index([createdAt], map: "idx_createdAt")
  @@index([newStatus], map: "idx_newStatus")
  @@index([reportId], map: "idx_reportId")
  @@index([reviewedBy], map: "idx_reviewedBy")
}

model report_tasks {
  id                Int                    @id @default(autoincrement())
  reportId          Int
  taskName          String                 @db.VarChar(500)
  priority          report_tasks_priority? @default(medium)
  plannedPercentage Int?                   @default(0)
  actualPercentage  Int?                   @default(0)
  status            report_tasks_status?   @default(not_started)
  timePlannedHours  Decimal?               @default(0.00) @db.Decimal(10, 2)
  timeSpentHours    Decimal?               @default(0.00) @db.Decimal(10, 2)
  deliverable       String?                @db.Text
  createdAt         DateTime?              @default(now()) @db.Timestamp(0)
  updatedAt         DateTime?              @default(now()) @db.Timestamp(0)
  reports           reports                @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_tasks_ibfk_1")

  @@index([priority], map: "idx_priority")
  @@index([reportId], map: "idx_reportId")
  @@index([status], map: "idx_status")
}

model report_time_by_task_type {
  id        Int       @id @default(autoincrement())
  reportId  Int
  taskType  String    @db.VarChar(100)
  hours     Decimal?  @default(0.00) @db.Decimal(10, 2)
  createdAt DateTime? @default(now()) @db.Timestamp(0)
  updatedAt DateTime? @default(now()) @db.Timestamp(0)
  reports   reports   @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_time_by_task_type_ibfk_1")

  @@index([reportId], map: "idx_reportId")
  @@index([taskType], map: "idx_taskType")
}

model report_version_tasks {
  id                Int                            @id @default(autoincrement())
  versionId         Int
  taskName          String                         @db.VarChar(500)
  priority          report_version_tasks_priority? @default(medium)
  plannedPercentage Int?                           @default(0)
  actualPercentage  Int?                           @default(0)
  status            report_version_tasks_status?   @default(not_started)
  timePlannedHours  Decimal?                       @default(0.00) @db.Decimal(10, 2)
  timeSpentHours    Decimal?                       @default(0.00) @db.Decimal(10, 2)
  deliverable       String?                        @db.Text
  report_versions   report_versions                @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_version_tasks_ibfk_1")

  @@index([versionId], map: "idx_versionId")
}

model report_versions {
  id                                       Int                    @id @default(autoincrement())
  reportId                                 Int
  versionNumber                            Int
  submittedAt                              DateTime               @db.Timestamp(0)
  submittedBy                              Int?
  reviewCommentFromManager                 String?                @db.Text
  reviewedBy                               Int?
  reviewedAt                               DateTime?              @db.Timestamp(0)
  status                                   report_versions_status
  createdAt                                DateTime?              @default(now()) @db.Timestamp(0)
  report_version_tasks                     report_version_tasks[]
  reports                                  reports                @relation(fields: [reportId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "report_versions_ibfk_1")
  users_report_versions_submittedByTousers users?                 @relation("report_versions_submittedByTousers", fields: [submittedBy], references: [id], onUpdate: NoAction, map: "report_versions_ibfk_2")
  users_report_versions_reviewedByTousers  users?                 @relation("report_versions_reviewedByTousers", fields: [reviewedBy], references: [id], onUpdate: NoAction, map: "report_versions_ibfk_3")

  @@unique([reportId, versionNumber], map: "unique_report_version")
  @@index([reportId], map: "idx_reportId")
  @@index([versionNumber], map: "idx_versionNumber")
  @@index([reviewedBy], map: "reviewedBy")
  @@index([submittedBy], map: "submittedBy")
}

model reports {
  id                                  Int                        @id @default(autoincrement())
  userId                              Int
  weekStartDate                       DateTime                   @db.Date
  weekEndDate                         DateTime                   @db.Date
  projectId                           Int?
  status                              reports_status?            @default(draft)
  lastReviewComment                   String?                    @db.Text
  lastReviewedBy                      Int?
  lastReviewedAt                      DateTime?                  @db.Timestamp(0)
  submittedAt                         DateTime?                  @db.Timestamp(0)
  approvedAt                          DateTime?                  @db.Timestamp(0)
  createdAt                           DateTime?                  @default(now()) @db.Timestamp(0)
  updatedAt                           DateTime?                  @default(now()) @db.Timestamp(0)
  report_achievements                 report_achievements[]
  report_blockers                     report_blockers[]
  report_next_week_tasks              report_next_week_tasks[]
  report_optional_fields              report_optional_fields[]
  report_review_history               report_review_history[]
  report_tasks                        report_tasks[]
  report_time_by_task_type            report_time_by_task_type[]
  report_versions                     report_versions[]
  users_reports_userIdTousers         users                      @relation("reports_userIdTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reports_ibfk_1")
  projects                            projects?                  @relation(fields: [projectId], references: [id], onUpdate: NoAction, map: "reports_ibfk_2")
  users_reports_lastReviewedByTousers users?                     @relation("reports_lastReviewedByTousers", fields: [lastReviewedBy], references: [id], onUpdate: NoAction, map: "reports_ibfk_3")

  @@unique([userId, weekStartDate], map: "unique_user_week")
  @@index([createdAt], map: "idx_createdAt")
  @@index([projectId], map: "idx_projectId")
  @@index([status], map: "idx_status")
  @@index([userId], map: "idx_userId")
  @@index([weekStartDate, weekEndDate], map: "idx_weekDates")
  @@index([lastReviewedBy], map: "lastReviewedBy")
}

model roles {
  id          Int          @id @default(autoincrement())
  name        String       @unique(map: "name") @db.VarChar(50)
  description String?      @db.VarChar(255)
  createdAt   DateTime?    @default(now()) @db.Timestamp(0)
  updatedAt   DateTime?    @default(now()) @db.Timestamp(0)
  user_roles  user_roles[]

  @@index([name], map: "idx_name")
}

model user_roles {
  id                                 Int       @id @default(autoincrement())
  userId                             Int
  roleId                             Int
  assignedBy                         Int?
  createdAt                          DateTime? @default(now()) @db.Timestamp(0)
  updatedAt                          DateTime? @default(now()) @db.Timestamp(0)
  users_user_roles_userIdTousers     users     @relation("user_roles_userIdTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_ibfk_1")
  roles                              roles     @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_roles_ibfk_2")
  users_user_roles_assignedByTousers users?    @relation("user_roles_assignedByTousers", fields: [assignedBy], references: [id], onUpdate: NoAction, map: "user_roles_ibfk_3")

  @@unique([userId, roleId], map: "unique_user_role")
  @@index([assignedBy], map: "assignedBy")
  @@index([roleId], map: "idx_roleId")
  @@index([userId], map: "idx_userId")
}

model users {
  id                                                 Int                     @id @default(autoincrement())
  email                                              String                  @unique(map: "email") @db.VarChar(255)
  password                                           String                  @db.VarChar(255)
  firstName                                          String                  @db.VarChar(100)
  lastName                                           String                  @db.VarChar(100)
  profilePhoto                                       String?                 @db.VarChar(500)
  bio                                                String?                 @db.Text
  status                                             users_status?           @default(active)
  lastLogin                                          DateTime?               @db.Timestamp(0)
  createdAt                                          DateTime?               @default(now()) @db.Timestamp(0)
  updatedAt                                          DateTime?               @default(now()) @db.Timestamp(0)
  project_team_members                               project_team_members[]
  projects                                           projects[]
  report_review_history                              report_review_history[]
  report_versions_report_versions_submittedByTousers report_versions[]       @relation("report_versions_submittedByTousers")
  report_versions_report_versions_reviewedByTousers  report_versions[]       @relation("report_versions_reviewedByTousers")
  reports_reports_userIdTousers                      reports[]               @relation("reports_userIdTousers")
  reports_reports_lastReviewedByTousers              reports[]               @relation("reports_lastReviewedByTousers")
  user_roles_user_roles_userIdTousers                user_roles[]            @relation("user_roles_userIdTousers")
  user_roles_user_roles_assignedByTousers            user_roles[]            @relation("user_roles_assignedByTousers")

  @@index([email], map: "idx_email")
  @@index([status], map: "idx_status")
}

enum report_achievements_impact {
  low
  medium
  high
}

enum report_blockers_impact {
  low
  medium
  high
}

enum report_next_week_tasks_priority {
  low
  medium
  high
  critical
}

enum report_review_history_previousStatus {
  draft
  submitted
  needs_correction
  approved
}

enum report_tasks_priority {
  low
  medium
  high
  critical
}

enum report_version_tasks_priority {
  low
  medium
  high
  critical
}

enum projects_status {
  active
  archived
}

enum report_review_history_newStatus {
  draft
  submitted
  needs_correction
  approved
}

enum reports_status {
  draft
  submitted
  needs_correction
  approved
}

enum report_tasks_status {
  not_started
  in_progress
  completed
  blocked
}

enum report_version_tasks_status {
  not_started
  in_progress
  completed
  blocked
}

enum users_status {
  active
  inactive
  suspended
}

enum report_versions_status {
  submitted
  needs_correction
  approved
}
