datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  password  String
  fullName  String
  role      String  @default("team_member")
  createdAt DateTime @default(now())
  
  reports   Report[]
  reviews   ReviewComment[]
  
  @@index([email])
  @@map("users")
}

model Report {
  id              Int     @id @default(autoincrement())
  userId          Int
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  weekStartDate   DateTime
  projectId       Int?
  project         Project? @relation(fields: [projectId], references: [id])
  
  status          String  @default("Draft")
  achievements    String?
  blockers        String?
  plannedNextWeek String?
  keyAchievement  String?
  keyBlocker      String?
  notes           String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tasks           ReportTask[]
  reviews         ReviewComment[]
  
  @@index([userId, status])
  @@index([weekStartDate])
  @@map("reports")
}

model ReportTask {
  id                  Int     @id @default(autoincrement())
  reportId            Int
  report              Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  taskName            String
  priority            String
  plannedPercentage   Int     @default(0)
  actualPercentage    Int     @default(0)
  status              String
  timePlannedHours    Float   @default(0)
  timeSpentHours      Float   @default(0)
  deliverable         String?
  
  @@index([reportId])
  @@map("report_tasks")
}

model ReviewComment {
  id          Int     @id @default(autoincrement())
  reportId    Int
  report      Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  managerId   Int
  manager     User    @relation(fields: [managerId], references: [id])
  
  comment     String
  action      String
  createdAt   DateTime @default(now())
  
  @@index([reportId])
  @@map("review_comments")
}

model Project {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  createdAt   DateTime @default(now())
  
  reports     Report[]
  
  @@index([name])
  @@map("projects")
}